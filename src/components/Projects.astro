---
import GeometricDecoration from "./GeometricDecoration.astro";

interface Tag {
  name: string;
  color: string;
}
interface Project {
  title: string;
  description: string;
  image: string;
  link: string;
  tags: Tag[];
  github: string;
}

const TAGS = {
  PHOTOSHOP: { name: "Photoshop",  color: "bg-coral/10 text-coral border-coral/20" },
  JUMPSELLER: { name: "Jumpseller", color: "bg-ocean/10 text-ocean border-ocean/20" },
  ILLUSTRATOR: { name: "Illustrator", color: "bg-plum/10 text-plum border-plum/20" },
  HTML:       { name: "HTML",       color: "bg-mint/10 text-mint border-mint/20" },
  CSS:        { name: "CSS",        color: "bg-ocean/10 text-ocean border-ocean/20" },
  JAVASCRIPT: { name: "JavaScript", color: "bg-sunflower/20 text-charcoal border-sunflower/30" },
};

const projects: Project[] = [
  {
    title: "Poster Mob Psycho 100",
    description: "Diseño gráfico de poster para el anime Mob Psycho 100, con tipografía dinámica y paleta de colores intensa.",
    image: "/img/projects/mob.png",
    link: "https://www.behance.net/gallery/227800757/Poster-Chigeo-Kageyama",
    tags: [TAGS.PHOTOSHOP],
    github: "",
  },
  {
    title: "Chetomi",
    description: "Ecommerce completo para Chetomi, tienda de comida argentina. Diseño y desarrollo en Jumpseller.",
    image: "/img/projects/chetomiweb.webp",
    link: "https://www.chetomi.cl",
    tags: [TAGS.JUMPSELLER],
    github: "",
  },
];
---

<div class="w-full relative">

  <!-- Decorative -->
  <GeometricDecoration shape="circle"  color="#FF6B6B" size="xl" class="absolute -top-16 -right-16 opacity-5 hidden lg:block" animate={false} />
  <GeometricDecoration shape="dots"    color="#4ECDC4" size="md" class="absolute bottom-8 right-0 opacity-20 hidden md:block" animate={true} />

  <!-- Header -->
  <div class="gsap-reveal flex items-end justify-between mb-12 md:mb-16">
    <div>
      <p class="text-slate font-bold text-sm tracking-widest uppercase mb-2">/Proyectos</p>
      <h2 class="section-heading text-charcoal">
        Lo que he<br/>
        <span class="text-coral">construido.</span>
      </h2>
    </div>
    <span class="text-8xl font-extrabold text-charcoal/5 leading-none hidden md:block select-none">
      {String(projects.length).padStart(2, '0')}
    </span>
  </div>

  <!-- Project list -->
  <div class="space-y-2 gsap-stagger-parent">
    {projects.map((project, i) => (
      <article class="gsap-stagger-child group relative">
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          data-preview-img={project.image}
          class="project-row flex flex-col md:flex-row md:items-center gap-4 md:gap-8 py-6 md:py-8 px-0 border-b border-charcoal/10 hover:border-coral/30 transition-all duration-300 md:cursor-none"
        >
          <!-- Number -->
          <span class="project-num text-3xl md:text-4xl font-extrabold text-charcoal/15 group-hover:text-coral/30 transition-colors duration-300 leading-none flex-shrink-0 hidden md:block">
            {String(i + 1).padStart(2, '0')}
          </span>

          <!-- Thumbnail -->
          <div class="project-thumb w-full md:w-28 h-44 md:h-20 rounded-xl overflow-hidden flex-shrink-0 bg-charcoal/5">
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <h3 class="project-title font-extrabold text-charcoal group-hover:text-coral transition-colors duration-300"
              style="font-size: clamp(1.25rem, 3vw, 1.75rem); letter-spacing: -0.02em;">
              {project.title}
            </h3>
            <p class="text-slate mt-1 leading-relaxed text-sm md:text-base line-clamp-2">
              {project.description}
            </p>
            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mt-3">
              {project.tags.map(tag => (
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ${tag.color}`}>
                  {tag.name}
                </span>
              ))}
            </div>
          </div>

          <!-- Arrow CTA -->
          <div class="project-arrow flex-shrink-0 w-10 h-10 rounded-full border-2 border-charcoal/20 group-hover:border-coral group-hover:bg-coral items-center justify-center transition-all duration-300 hidden md:flex">
            <svg class="w-4 h-4 text-charcoal/40 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </a>
      </article>
    ))}
  </div>

  <!-- Project image preview — centered, crossfades between projects -->
  <div
    id="project-preview"
    aria-hidden="true"
    style="position:fixed;width:620px;height:420px;border-radius:1rem;overflow:hidden;box-shadow:0 32px 64px -12px rgba(0,0,0,0.45);pointer-events:none;opacity:0;z-index:9999;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.92);will-change:transform,opacity;"
  >
    <!-- Two stacked images for crossfade transition -->
    <img id="preview-img-a" src="" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity 0.4s ease;" />
    <img id="preview-img-b" src="" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity 0.4s ease;" />
  </div>

  <!-- Star cursor — desktop only -->
  <div id="star-cursor" aria-hidden="true" style="position:fixed;top:0;left:0;z-index:10000;pointer-events:none;opacity:0;font-size:1.5rem;line-height:1;will-change:transform,opacity;">✨</div>

  <!-- Footer CTA -->
  <div class="gsap-reveal mt-12 text-center md:text-left">
    <a
      href="https://github.com/gitcjavier"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-outline-dark inline-flex"
    >
      Ver más en GitHub
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>
</div>

<script>
  import gsap from 'gsap';

  function initProjectPreview() {
    if (!window.matchMedia('(min-width: 768px)').matches) return;

    const preview    = document.getElementById('project-preview');
    const imgA       = document.getElementById('preview-img-a') as HTMLImageElement | null;
    const imgB       = document.getElementById('preview-img-b') as HTMLImageElement | null;
    const starCursor = document.getElementById('star-cursor');
    if (!preview || !imgA || !imgB || !starCursor) return;

    // Preview stays centered — GSAP only controls opacity and scale, not position
    gsap.set(preview, { xPercent: -50, yPercent: -50 });

    // Which img layer is currently "on top"
    let activeLayer: 'a' | 'b' = 'a';
    let isVisible = false;
    let enterTween: gsap.core.Tween | null = null;

    // Star blink loop
    const blinkTl = gsap.timeline({ repeat: -1, paused: true });
    blinkTl
      .to(starCursor, { opacity: 1, scale: 1.4, duration: 0.3, ease: 'power1.inOut' })
      .to(starCursor, { opacity: 0.5, scale: 1,  duration: 0.3, ease: 'power1.inOut' });

    function crossfadeTo(src: string) {
      if (!imgA || !imgB) return;
      const next = activeLayer === 'a' ? imgB : imgA;
      const curr = activeLayer === 'a' ? imgA : imgB;

      next.src = src;
      next.style.opacity = '0';
      requestAnimationFrame(() => {
        next.style.opacity = '1';
        curr.style.opacity = '0';
      });
      activeLayer = activeLayer === 'a' ? 'b' : 'a';
    }

    document.querySelectorAll('[data-preview-img]').forEach(row => {
      row.addEventListener('mouseenter', () => {
        const src = row.getAttribute('data-preview-img') ?? '';

        if (!isVisible) {
          // First entry: load both layers with same src, fade in preview
          imgA.src = src;
          imgB.src = src;
          imgA.style.opacity = '1';
          imgB.style.opacity = '0';
          activeLayer = 'a';
          isVisible = true;

          enterTween?.kill();
          enterTween = gsap.to(preview, {
            opacity: 1, scale: 1,
            duration: 0.45, ease: 'back.out(1.3)',
          });
        } else {
          // Already visible — crossfade to new image
          crossfadeTo(src);
        }

        // Star cursor
        gsap.to(starCursor, { opacity: 1, duration: 0.15 });
        blinkTl.play();
      });

      row.addEventListener('mouseleave', () => {
        // Only hide if leaving ALL project rows (not entering another immediately)
        // Use a short delay so moving between rows doesn't flicker
        setTimeout(() => {
          const anyHovered = !!document.querySelector('[data-preview-img]:hover');
          if (!anyHovered) {
            isVisible = false;
            enterTween?.kill();
            enterTween = gsap.to(preview, {
              opacity: 0, scale: 0.92,
              duration: 0.3, ease: 'power2.in',
            });
            gsap.to(starCursor, { opacity: 0, duration: 0.15, onComplete: () => { blinkTl.pause(); } });
          }
        }, 40);
      });

      // Star follows cursor, preview stays centered
      row.addEventListener('mousemove', e => {
        const me = e as MouseEvent;
        gsap.set(starCursor, { x: me.clientX - 12, y: me.clientY - 12 });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectPreview);
  } else {
    requestAnimationFrame(initProjectPreview);
  }
  document.addEventListener('astro:page-load', () => requestAnimationFrame(initProjectPreview));
</script>
