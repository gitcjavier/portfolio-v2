---
interface Project {
  name: string;
  description: string;
  image: string;
  link: string;
}

const projects: Project[] = [
  {
    name: "Chetomi",
    description: "Ecommerce completo de comida argentina — diseño y desarrollo en Jumpseller",
    image: "/img/projects/chetomiweb.webp",
    link: "https://www.chetomi.cl",
  },
  {
    name: "Mob Psycho 100",
    description: "Diseño gráfico de poster con tipografía dinámica y paleta intensa",
    image: "/img/projects/mob.png",
    link: "https://www.behance.net/gallery/227800757/Poster-Chigeo-Kageyama",
  },
];
---

<section id="projects" class="max-w-[1200px] mx-auto px-6 py-12">
  <div class="flex flex-col gap-16 md:gap-20">
    {projects.map((project, i) => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        style={`animation-delay: ${0.1 + (i % 2) * 0.1}s`}
        class="block group"
      >
        <div class="ml-20 md:ml-28 mb-5">
          <h3 class="font-mondwest font-semibold text-2xl md:text-3xl text-ink group-hover:opacity-70 transition-opacity">
            {project.name}
          </h3>
          <p class="text-sm md:text-base text-ink/70 mt-1">{project.description}</p>
        </div>
        <img
          src={project.image}
          alt={project.name}
          loading="lazy"
          class="w-full rounded-2xl shadow-lg object-cover"
        />
      </a>
    ))}
  </div>
</section>
