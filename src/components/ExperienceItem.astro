---
interface Props {
  date: string;
  title: string;
  description: string;
  link?: string;
}
const { date, title, description } = Astro.props;
---

<li class="gsap-stagger-child exp-item relative pl-8 pb-12 last:pb-0">
  <!-- Timeline dot -->
  <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-coral border-4 border-cream shadow-sm"></div>

  <time class="text-slate text-sm font-bold tracking-wide uppercase block mb-2">{date}</time>
  <h3 class="font-extrabold text-charcoal mb-3" style="font-size: clamp(1.1rem, 2.5vw, 1.4rem); letter-spacing: -0.02em;">
    {title}
  </h3>
  <p class="text-slate leading-relaxed" style="font-size: clamp(0.9rem, 1.8vw, 1rem);">{description}</p>
</li>

<style>
  .exp-item {
    border-radius: 0.75rem;
    margin-left: -0.75rem;
    padding-left: calc(2rem + 0.75rem);
    padding-right: 0.75rem;
    padding-top: 0.5rem;
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .exp-item:hover {
    background: rgba(255, 107, 107, 0.04);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07), 0 1px 4px rgba(255, 107, 107, 0.06);
    transform: translateX(4px);
  }
</style>
