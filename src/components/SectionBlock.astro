---
export interface Props {
  id?: string;
  bg?: string;       // Tailwind bg class or inline color
  class?: string;
  fullHeight?: boolean;
  snapSection?: boolean;
}

const { id, bg = 'bg-cream', class: className = '', fullHeight = false, snapSection = false } = Astro.props;
---

<section
  id={id}
  data-section={snapSection ? id : undefined}
  class:list={[
    'relative w-full',
    snapSection
      ? 'h-screen flex items-center overflow-y-auto'
      : fullHeight
        ? 'min-h-screen flex items-center overflow-hidden'
        : 'py-24 md:py-32 lg:py-40 overflow-hidden',
    bg,
    className,
  ]}
>
  <div class="container mx-auto mobile-px w-full">
    <slot />
  </div>
</section>
