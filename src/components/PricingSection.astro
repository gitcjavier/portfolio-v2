---
import Button from "./Button.astro";
const EMAIL = "mailto:icastroretamal@gmail.com";
---

<section id="pricing" class="w-full py-12 px-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:max-w-4xl md:ml-auto">

    <!-- Card oscura: partnership mensual -->
    <div
      data-reveal
      style="animation-delay: 0.1s"
      class="bg-ink rounded-[40px] pl-10 pr-10 md:pr-24 pt-3 pb-10 shadow-[inset_0_2px_12px_rgba(255,255,255,0.08)]"
    >
      <h3 class="text-[22px] font-medium text-mist mt-7">Partnership mensual</h3>
      <p class="text-fog text-sm leading-relaxed mt-3">
        Diseño y desarrollo dedicados para tu marca.<br />
        Trabajas directamente conmigo.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-10">
        <Button href={EMAIL} variant="primary">Hablemos</Button>
        <Button href={EMAIL} variant="secondary">Cómo funciona</Button>
      </div>
    </div>

    <!-- Card clara: proyecto puntual -->
    <div
      data-reveal
      style="animation-delay: 0.2s"
      class="bg-white rounded-[40px] pl-10 pr-10 md:pr-24 pt-3 pb-10 shadow-card"
    >
      <h3 class="text-[22px] font-medium text-ink2 mt-7">Proyecto a medida</h3>
      <p class="text-mutedink text-sm leading-relaxed mt-3">
        Alcance fijo, plazo fijo.<br />
        El mismo estándar, de la idea al deploy.
      </p>
      <div class="flex mt-10">
        <Button href={EMAIL} variant="tertiary">Hablemos</Button>
      </div>
    </div>

  </div>
</section>
