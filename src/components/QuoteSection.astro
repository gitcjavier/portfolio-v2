---
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-12 px-6 max-w-2xl mx-auto">
  <div data-reveal style="animation-delay: 0.1s">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6 text-slate-900"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/>
      <path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/>
    </svg>
  </div>

  <blockquote
    data-reveal
    style="animation-delay: 0.2s"
    class="text-[32px] md:text-[40px] lg:text-[44px] leading-[1.1] text-ink2 tracking-tight mt-6"
  >
    {t.quote.before}<span class="font-mondwest">{t.quote.accent}</span>{t.quote.after}
  </blockquote>

  <p data-reveal style="animation-delay: 0.3s" class="italic text-sm text-mutedink mt-6">
    {t.quote.author}
  </p>

  <div data-reveal style="animation-delay: 0.4s" class="mt-8 overflow-visible">
    <div id="morph-photo-wrap" class="w-full max-w-xs cursor-pointer">
      <img
        id="parallax-photo"
        src="/img/javoru2.webp"
        alt={t.quote.photoAlt}
        loading="lazy"
        class="w-full shadow-lg will-change-transform"
        style="border-radius: 16px;"
      />
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initParallax() {
    const img = document.getElementById('parallax-photo');
    if (!img || img.dataset.parallaxInit) return;
    img.dataset.parallaxInit = 'true';

    let visible = false;
    let ticking = false;
    const MAX_OFFSET = 200;

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { visible = e.isIntersecting; });
    });
    io.observe(img);

    function update() {
      ticking = false;
      if (!img) return;
      const rect = img.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
      const offset = (progress - 0.5) * -MAX_OFFSET * 0.5;
      img.style.transform = `translateY(${offset}px)`;
    }

    window.addEventListener('scroll', () => {
      if (visible && !ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  function initPhotoMorph() {
    const wrap = document.getElementById('morph-photo-wrap');
    const img = document.getElementById('parallax-photo');
    if (!wrap || !img) return;
    if (wrap.dataset.morphInit) return;
    wrap.dataset.morphInit = 'true';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const SHAPES = [
      '58% 42% 33% 67% / 63% 30% 70% 37%',
      '40% 60% 70% 30% / 47% 62% 38% 53%',
      '50% 50% 50% 50% / 50% 50% 50% 50%',
      '67% 33% 47% 53% / 37% 20% 80% 63%',
      '28% 72% 44% 56% / 49% 40% 60% 51%',
      '24% 24% 24% 24% / 24% 24% 24% 24%',
    ];

    let morphTl: gsap.core.Timeline | null = null;

    wrap.addEventListener('mouseenter', () => {
      morphTl?.kill();
      morphTl = gsap.timeline({
        repeat: -1,
        yoyo: true,
        defaults: { duration: 1.1, ease: 'sine.inOut' },
      });
      SHAPES.forEach((shape) => morphTl!.to(img, { borderRadius: shape }));
    });

    wrap.addEventListener('mouseleave', () => {
      morphTl?.kill();
      morphTl = null;
      gsap.to(img, { borderRadius: '16px', duration: 0.7, ease: 'power2.out' });
    });
  }

  function init() {
    initParallax();
    initPhotoMorph();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
