---
import { ClientRouter } from "astro:transitions";
export interface Props {
  title: string;
  description: string;
  keywords: string;
  author: string;
}
const { title, description, keywords, author } = Astro.props;
---

<!doctype html>
<html lang="es" transition:persist="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="preload" href="/img/javoru2.webp" as="image" />
  </head>
  <body>
    <div class="page-content">
      <ClientRouter />
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/mobile.css';

  :root {
    color-scheme: light;
  }

  html {
    scroll-behavior: auto;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
  }

  body {
    font-family: Onest, system-ui, sans-serif;
    line-height: 1.6;
    scroll-behavior: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    background-color: #FFF8F0;
    color: #2D2D2D;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #FFF8F0; }
  ::-webkit-scrollbar-thumb { background: #FF6B6B; border-radius: 9999px; }
  ::-webkit-scrollbar-thumb:hover { background: #e85555; }

  /* Selection */
  ::selection { background: #FF6B6B; color: #ffffff; }

  /* Focus */
  button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible {
    outline: 2px solid #FF6B6B;
    outline-offset: 2px;
  }

  /* Prevent horizontal scroll */
  * { box-sizing: border-box; }
  body { overflow-x: hidden; }
</style>
