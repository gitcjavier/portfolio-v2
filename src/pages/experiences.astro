---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Experience from '../components/Experience.astro';
import "../styles/global.css";
---

<Layout
  title="Experiencia Laboral — Javier Castro"
  description="Trayectoria profesional de Javier Castro Retamal"
  keywords="experiencia, desarrollador, portfolio, IT, data engineer"
  author="Javier Castro Retamal"
>
  <Header />

  <main class="min-h-screen bg-cream pt-24 pb-20">
    <!-- Back button -->
    <div class="container mx-auto mobile-px mb-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-slate hover:text-coral font-semibold transition-colors duration-200 group"
      >
        <span class="w-8 h-8 rounded-full border-2 border-charcoal/20 group-hover:border-coral group-hover:bg-coral flex items-center justify-center transition-all duration-200">
          <svg class="w-4 h-4 text-charcoal/50 group-hover:text-white transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </span>
        Volver al portfolio
      </a>
    </div>

    <!-- Hero heading -->
    <div class="container mx-auto mobile-px mb-16">
      <p class="text-slate font-bold text-sm tracking-widest uppercase mb-3">/Experiencia</p>
      <h1 class="section-heading text-charcoal">
        Trayectoria<br/>
        <span class="text-coral">profesional.</span>
      </h1>
      <p class="text-slate mt-4 max-w-lg leading-relaxed" style="font-size: clamp(0.95rem, 2vw, 1.1rem);">
        Mi camino en tecnología — de soporte técnico a ingeniería de datos y desarrollo frontend.
      </p>
    </div>

    <!-- Timeline -->
    <div class="container mx-auto mobile-px">
      <Experience />
    </div>
  </main>

  <script>
    import '../scripts/gsap-animations.js';
  </script>
</Layout>
