---
interface Props {
  date: string;
  title: string;
  description: string;
  link?: string;
}
const { date, title, description } = Astro.props;
---

<li class="gsap-stagger-child relative pl-8 pb-12 last:pb-0">
  <!-- Timeline dot -->
  <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-coral border-4 border-cream shadow-sm"></div>

  <time class="text-slate text-sm font-bold tracking-wide uppercase block mb-2">{date}</time>
  <h3 class="font-extrabold text-charcoal mb-3" style="font-size: clamp(1.1rem, 2.5vw, 1.4rem); letter-spacing: -0.02em;">
    {title}
  </h3>
  <p class="text-slate leading-relaxed" style="font-size: clamp(0.9rem, 1.8vw, 1rem);">{description}</p>
</li>
