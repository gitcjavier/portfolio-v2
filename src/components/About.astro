---
import GeometricDecoration from "./GeometricDecoration.astro";
---

<div class="w-full relative">

  <!-- Decorative shapes -->
  <GeometricDecoration shape="ring"   color="#ffffff" size="xl" class="absolute -top-10 -right-10 opacity-10 hidden lg:block" animate={true} />
  <GeometricDecoration shape="dots"   color="#FFF8F0" size="lg" class="absolute bottom-0 left-0 opacity-15 hidden md:block" animate={false} />
  <GeometricDecoration shape="cross"  color="#F7DC6F" size="sm" class="absolute top-8 right-1/4 opacity-40 hidden sm:block" animate={true} />

  <!-- Section label -->
  <p class="gsap-reveal text-white/70 font-bold text-sm tracking-widest uppercase mb-3">/Self</p>

  <!-- Main content -->
  <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">

    <!-- Left: Bio split -->
    <div class="w-full lg:w-1/2 space-y-8">
      <div class="gsap-reveal">
        <h2 class="text-white font-extrabold mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
          Diseño
        </h2>
        <p class="text-white/80 leading-relaxed" style="font-size: clamp(0.95rem, 2vw, 1.1rem);">
          Soy un desarrollador Frontend apasionado por crear experiencias web excepcionales.
          Me especializo en tecnologías modernas y me mantengo constantemente actualizado
          con las últimas tendencias en desarrollo web.
        </p>
      </div>

      <div class="gsap-reveal">
        <h2 class="text-white font-extrabold mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
          Ingeniería
        </h2>
        <p class="text-white/80 leading-relaxed" style="font-size: clamp(0.95rem, 2vw, 1.1rem);">
          Mi enfoque se centra en escribir código limpio y mantenible,
          crear interfaces intuitivas y asegurar que cada proyecto cumpla
          con los más altos estándares de calidad y rendimiento.
        </p>
      </div>

      <!-- SVG pattern decoration (original, matches olaolu.dev aesthetic) -->
      <div class="hidden md:block opacity-60">
        <svg xmlns="http://www.w3.org/2000/svg" width="180" height="100" viewBox="0 0 325 193" aria-hidden="true">
          <path fill="none" stroke="#ffffff" stroke-miterlimit="50" stroke-width="2"
            d="M17.053 9.57a7.891 7.891 0 11-15.782 0 7.891 7.891 0 0115.782 0zM45.122 9.57a7.891 7.891 0 11-15.782 0 7.891 7.891 0 0115.782 0zM73.19 9.57a7.891 7.891 0 11-15.781 0 7.891 7.891 0 0115.782 0zM101.26 9.57a7.891 7.891 0 11-15.782 0 7.891 7.891 0 0115.782 0zM129.329 9.57a7.891 7.891 0 11-15.783 0 7.891 7.891 0 0115.783 0zM238.083 103.963v0l-.561 22.259v0l22.259-.561v0l-.561 22.258v0l22.259-.56v0l-.561 22.258v0l22.259-.56v0l-.559 22.26v0l22.26-.56v0"/>
        </svg>
      </div>
    </div>

    <!-- Right: Skills + CTAs -->
    <div class="w-full lg:w-1/2 space-y-8">

      <!-- Tech pills grid -->
      <div class="gsap-stagger-parent">
        <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-4 opacity-80">Tecnologías</h3>
        <div class="flex flex-wrap gap-2">
          <span class="gsap-stagger-child tech-pill"><img src="/icons/Astro_dark.svg" class="w-4 h-4 brightness-0 invert" alt="">Astro</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/tailwindcss.svg" class="w-4 h-4" alt="">Tailwind CSS</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/javascript.svg" class="w-4 h-4" alt="">JavaScript</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/typescript.svg" class="w-4 h-4" alt="">TypeScript</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/react.svg" class="w-4 h-4" alt="">React</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/css3.svg" class="w-4 h-4" alt="">CSS3</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/html5.svg" class="w-4 h-4" alt="">HTML5</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/supabase.svg" class="w-4 h-4" alt="">Supabase</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/git.svg" class="w-4 h-4" alt="">Git</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/photoshop.svg" class="w-4 h-4" alt="">Photoshop</span>
          <span class="gsap-stagger-child tech-pill"><img src="/icons/illustrator.svg" class="w-4 h-4" alt="">Illustrator</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="gsap-reveal flex flex-col xs:flex-row gap-3 pt-2">
        <a
          href="/resume.pdf"
          target="_blank"
          class="btn-outline-white"
        >
          Descargar CV
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>
        <a
          href="/experiences"
          class="btn-outline-white"
        >
          💼 Experiencia
        </a>
      </div>

    </div>
  </div>
</div>
