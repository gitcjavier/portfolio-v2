---
import { ClientRouter } from "astro:transitions";
import type { Lang } from "../i18n/config";
import { getAlternatePaths } from "../i18n/utils";

export interface Props {
  title: string;
  description: string;
  keywords: string;
  author: string;
  lang: Lang;
}

const { title, description, keywords, author, lang } = Astro.props;
const alternates = getAlternatePaths(Astro.url.pathname);
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<!doctype html>
<html lang={lang} transition:persist="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <title>{title}</title>
    <link rel="alternate" hreflang="es" href={`${siteOrigin}${alternates.es}`} />
    <link rel="alternate" hreflang="en" href={`${siteOrigin}${alternates.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${alternates.es}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-content">
      <ClientRouter />
      <slot />
    </div>

    <script>
      function initReveal() {
        const els = document.querySelectorAll('[data-reveal]:not(.animate-fade-in-up)');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate-fade-in-up');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>

    <script src="../scripts/locale-detect.ts"></script>
  </body>
</html>

<style is:global>
  @import '../styles/mobile.css';

  :root {
    color-scheme: light;
  }

  html {
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
  }

  body {
    font-family: 'PP Neue Montreal', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    background-color: #ffffff;
    color: #051A24;
  }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #ffffff; }
  ::-webkit-scrollbar-thumb { background: #0D212C; border-radius: 9999px; }
  ::-webkit-scrollbar-thumb:hover { background: #273C46; }

  ::selection { background: #051A24; color: #F6FCFF; }

  button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible {
    outline: 2px solid #051A24;
    outline-offset: 2px;
  }

  * { box-sizing: border-box; }
  body { overflow-x: hidden; }
</style>
