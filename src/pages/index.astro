---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import QuoteSection from "../components/QuoteSection.astro";
import Projects from "../components/Projects.astro";
import InstagramSection from "../components/InstagramSection.astro";
import PartnerSection from "../components/PartnerSection.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils";
import "../styles/global.css";

const lang = 'es';
const t = useTranslations(lang);
---

<Layout
  title={t.meta.home.title}
  description={t.meta.home.description}
  keywords={t.meta.home.keywords}
  author={t.meta.author}
  lang={lang}
>
  <LanguageSwitcher lang={lang} />

  <main class="relative w-full bg-white">
    <Hero lang={lang} />
    <Marquee />
    <QuoteSection lang={lang} />
    <Projects lang={lang} />
    <InstagramSection lang={lang} />
    <PartnerSection lang={lang} />
    <Footer lang={lang} />
  </main>

  <BottomNav lang={lang} />
</Layout>
