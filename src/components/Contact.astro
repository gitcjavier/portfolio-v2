---
import GeometricDecoration from "./GeometricDecoration.astro";
---

<style>
  .email-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: #FFF8F0;
    color: #2D2D2D;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    z-index: 10;
  }
  .email-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #FFF8F0;
  }
  .contact-icon-btn:hover .email-tooltip {
    opacity: 1;
    visibility: visible;
  }
  .copy-success {
    background: #4ECDC4 !important;
    border-color: #4ECDC4 !important;
  }
</style>

<div class="w-full relative">

  <!-- Decorative -->
  <GeometricDecoration shape="ring"     color="#F7DC6F" size="xl"  class="absolute -top-12 -left-12 opacity-10 hidden lg:block" animate={true} />
  <GeometricDecoration shape="dots"     color="#ffffff" size="md"  class="absolute bottom-8 right-0 opacity-15 hidden md:block" animate={false} />
  <GeometricDecoration shape="triangle" color="#FF6B6B" size="sm"  class="absolute top-8 right-1/3 opacity-20 hidden sm:block" animate={true} />

  <!-- Label -->
  <p class="gsap-reveal text-white/60 font-bold text-sm tracking-widest uppercase mb-3">/Contacto</p>

  <!-- Heading -->
  <div class="gsap-reveal mb-12 md:mb-16">
    <h2 class="section-heading text-white leading-tight">
      ¿Trabajamos<br/>
      <span class="text-sunflower">juntos?</span>
    </h2>
    <p class="text-white/70 mt-4 max-w-lg leading-relaxed" style="font-size: clamp(0.95rem, 2vw, 1.1rem);">
      Siempre estoy interesado en escuchar sobre nuevos proyectos y oportunidades.
      Ya sea que tengas una idea o solo quieras saludar — escríbeme.
    </p>
  </div>

  <!-- Social icons row -->
  <div class="gsap-stagger-parent flex flex-row items-center gap-4 xs:gap-6 mb-12">

    <!-- Email -->
    <div class="contact-icon-btn gsap-stagger-child relative group cursor-pointer" id="email-btn">
      <div class="w-14 h-14 xs:w-16 xs:h-16 bg-coral rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-200">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="email-tooltip">icastroretamal@gmail.com</div>
      <p class="text-white/70 text-xs font-semibold text-center mt-2">Email</p>
    </div>

    <!-- GitHub -->
    <a
      href="https://github.com/gitcjavier"
      target="_blank"
      rel="noopener noreferrer"
      class="gsap-stagger-child group"
    >
      <div class="w-14 h-14 xs:w-16 xs:h-16 bg-charcoal rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-200">
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </div>
      <p class="text-white/70 text-xs font-semibold text-center mt-2">GitHub</p>
    </a>

    <!-- LinkedIn -->
    <a
      href="https://linkedin.com/in/javiercastroretamal"
      target="_blank"
      rel="noopener noreferrer"
      class="gsap-stagger-child group"
    >
      <div class="w-14 h-14 xs:w-16 xs:h-16 bg-ocean rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-200">
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </div>
      <p class="text-white/70 text-xs font-semibold text-center mt-2">LinkedIn</p>
    </a>

    <!-- Behance -->
    <a
      href="https://www.behance.net/javiercastro82"
      target="_blank"
      rel="noopener noreferrer"
      class="gsap-stagger-child group"
    >
      <div class="w-14 h-14 xs:w-16 xs:h-16 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-200" style="background-color: #1769FF;">
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029H23.7zm-7.249-4h4.953c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.476 2.219zM7.445 5c2.521 0 4.342.988 4.342 3.443 0 1.375-.588 2.322-1.676 2.898 1.566.533 2.335 1.715 2.335 3.44 0 3.066-2.317 4.22-5.139 4.22H0V5h7.445zM2.6 10.554h4.124c1.21 0 2.08-.49 2.08-1.813 0-1.275-.834-1.745-2.04-1.745H2.6v3.558zm0 6.017h4.332c1.334 0 2.325-.542 2.325-1.992 0-1.49-1.054-1.98-2.357-1.98H2.6v3.972z"/>
        </svg>
      </div>
      <p class="text-white/70 text-xs font-semibold text-center mt-2">Behance</p>
    </a>
  </div>

  <!-- Availability card -->
  <div class="gsap-reveal bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20 max-w-sm">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-3 h-3 bg-mint rounded-full animate-pulse"></div>
      <span class="text-white font-bold text-base">Disponible para proyectos</span>
    </div>
    <p class="text-white/60 text-sm leading-relaxed">
      Actualmente disponible para trabajo freelance y colaboraciones.
    </p>
  </div>

  <!-- Footer -->
  <div class="mt-16 pt-6 border-t border-white/10">
    <p class="text-white/30 text-sm">© 2025 — Con amor, Javoru.</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const emailBtn = document.getElementById('email-btn');
    if (!emailBtn) return;

    emailBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('icastroretamal@gmail.com');
        const iconDiv = emailBtn.querySelector('div');
        if (iconDiv) {
          iconDiv.classList.add('copy-success');
          setTimeout(() => iconDiv.classList.remove('copy-success'), 2000);
        }
      } catch {
        window.location.href = 'mailto:icastroretamal@gmail.com';
      }
    });
  });
</script>
